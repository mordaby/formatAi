{
  "name": "formatai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "eval": "pnpm --filter @formatai/eval run eval",
    "learn": "pnpm --filter @formatai/eval run learn",
    "convert": "pnpm --filter @formatai/eval run convert",
    "dev": "pnpm --parallel --filter @formatai/api --filter @formatai/web run dev"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
