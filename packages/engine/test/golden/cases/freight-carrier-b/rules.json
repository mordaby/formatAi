{
  "schemaVersion": 1,
  "name": "Carrier B invoice to freight cost report",
  "input": {
    "sheet": { "pick": "first" },
    "headerRow": "auto",
    "columns": [
      { "id": "shipId", "header": "Reference No", "type": "idLike", "required": true },
      { "id": "carrier", "header": "Vendor", "type": "text", "required": true },
      { "id": "cost", "header": "Total Cost", "type": "decimal", "required": true },
      { "id": "shipDate", "header": "Invoice Date", "type": "date", "inputFormats": ["YYYY-MM-DD"] }
    ]
  },
  "transform": {
    "computed": [],
    "valueMaps": [],
    "sort": [ { "column": "carrier", "dir": "asc" }, { "column": "shipId", "dir": "asc" } ],
    "group": {
      "by": "carrier",
      "showDetailRows": true,
      "subtotal": { "labelColumn": "shipId", "label": "Subtotal", "sum": ["cost"] },
      "blankRowsAfter": 1
    }
  },
  "output": {
    "sheetName": "Freight Cost Report",
    "direction": "ltr",
    "language": "en",
    "titleRows": [],
    "columns": [
      { "header": "Carrier", "from": "carrier" },
      { "header": "Shipment ID", "from": "shipId" },
      { "header": "Ship Date", "from": "shipDate", "format": "DD/MM/YYYY" },
      { "header": "Cost", "from": "cost", "format": "#,##0.00" }
    ],
    "headerStyle": { "bold": true },
    "grandTotal": { "labelColumn": "shipId", "label": "Total", "sum": ["cost"] }
  },
  "validations": [
    { "on": "output", "column": "Cost", "rule": "range", "min": 0, "severity": "flag" }
  ],
  "unsupported": [],
  "assumptions": [],
  "meta": { "source": "examplePair", "status": "verified" }
}
