# ---- API (apps/api) ----
PORT=8787
NODE_ENV=development
# Public origin of the web app (CORS + OIDC redirects)
WEB_ORIGIN=http://localhost:5173

# MongoDB — paste your connection string here (e.g. from MongoDB Atlas)
MONGODB_URI=
MONGODB_DB=formatai

# LLM provider (M1)
ANTHROPIC_API_KEY=

# Sign-in (M3) — OpenID Connect
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Admin allowlist (comma-separated verified emails)
ADMIN_EMAILS=

# Cloudflare Turnstile (M2)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
