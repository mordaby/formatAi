# ---- API (apps/api) ----
PORT=8787
NODE_ENV=development
# Public origin of the web app (CORS + OIDC redirects)
WEB_ORIGIN=http://localhost:5173

# MongoDB — local dev: mongodb://127.0.0.1:27017 (MongoDB Community service); prod: your Atlas connection string
MONGODB_URI=
MONGODB_DB=formatai

# LLM provider (M1): claude-cli (dev, uses your Claude Code login) | anthropic | openai | fake
LLM_PROVIDER=claude-cli
# Optional overrides for config/models.ts's firstTry/escalation model ids for the
# active LLM_PROVIDER, so switching models needs no code change. Leave unset to use
# the config defaults.
# LLM_MODEL_FIRST_TRY=
# LLM_MODEL_ESCALATION=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Path to the Claude Code CLI binary, only used by LLM_PROVIDER=claude-cli. Leave
# unset to use "claude" on PATH, falling back to `npx -y @anthropic-ai/claude-code`.
CLAUDE_CLI_PATH=

# Sign-in (M3) - OpenID Connect (authorization code + PKCE). A provider whose id AND secret are both set
# is offered ("Continue with ..."); the others are simply not shown.
#
# Signs the session cookie and the short sign-in cookie. Required when NODE_ENV=production
# (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
SESSION_SECRET=
# Public base URL of THIS API (not the web app): the redirect URIs below are built from it.
# Default http://localhost:8787 (= PORT). Required in production, e.g. https://api.example.com
API_PUBLIC_URL=http://localhost:8787
#
# Google - Google Cloud console > APIs & Services > Credentials > Create OAuth client ID > "Web application".
#   Authorized redirect URI:  http://localhost:8787/api/auth/google/callback
#                             <API_PUBLIC_URL>/api/auth/google/callback   (production)
#   OAuth consent screen scopes: openid, email, profile (no verification needed for these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft - Entra admin center (portal.azure.com) > App registrations > New registration.
#   Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#   (the API uses the multi-tenant `common` endpoint). Redirect URI, platform "Web":
#                             http://localhost:8787/api/auth/microsoft/callback
#                             <API_PUBLIC_URL>/api/auth/microsoft/callback   (production)
#   Certificates & secrets > New client secret (put its VALUE here). API permissions: Microsoft Graph delegated
#   openid, email, profile. Token configuration > Add optional claim (ID token): email.
#   Before approaching companies: complete Microsoft publisher verification (SPEC 12).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Admin (SPEC 12). Comma-separated. A user is an admin when a linked Google account has a VERIFIED email in
# ADMIN_EMAILS, or a linked Microsoft account has an object id (`oid`, or `tid:oid`) in MICROSOFT_ADMIN_OIDS.
# Microsoft's email claim is not verified, so it never grants admin - use the oid (the "Object ID" of the user in
# Entra > Users, or the `oid` claim of their ID token). Case-insensitive; changes apply on the next request.
ADMIN_EMAILS=
MICROSOFT_ADMIN_OIDS=

# Cloudflare Turnstile (M2)
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
# Secret for the ip:<hash> usage counters and learnId signatures (falls back to SESSION_SECRET).
# Required when NODE_ENV=production, as are TURNSTILE_SECRET_KEY and MONGODB_URI.
IP_HASH_SECRET=
# Behind a proxy/load balancer: how many proxy hops to trust for the client IP (integer), or "true".
# Leave unset when the API is reached directly.
TRUST_PROXY=
