{
  "schemaVersion": 1,
  "input": {
    "sheet": {
      "pick": "first"
    },
    "headerRow": "auto",
    "columns": [
      {
        "id": "orderId",
        "header": "Order ID",
        "type": "idLike",
        "required": true
      },
      {
        "id": "customer",
        "header": "Customer",
        "type": "text"
      },
      {
        "id": "region",
        "header": "Region",
        "type": "text"
      },
      {
        "id": "amount",
        "header": "Amount",
        "type": "decimal",
        "required": true
      },
      {
        "id": "status",
        "header": "Status",
        "type": "text",
        "required": true
      },
      {
        "id": "orderDate",
        "header": "Order Date",
        "type": "date",
        "required": true
      }
    ]
  },
  "transform": {
    "computed": [
      {
        "id": "priority",
        "type": "text",
        "expr": {
          "op": "switch",
          "cases": [
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "col": "status"
                  },
                  {
                    "const": "On hold"
                  }
                ]
              },
              "then": {
                "const": "Blocked"
              }
            },
            {
              "when": {
                "op": "and",
                "args": [
                  {
                    "op": "eq",
                    "args": [
                      {
                        "col": "status"
                      },
                      {
                        "const": "Open"
                      }
                    ]
                  },
                  {
                    "op": "gte",
                    "args": [
                      {
                        "col": "amount"
                      },
                      {
                        "const": 5000
                      }
                    ]
                  }
                ]
              },
              "then": {
                "const": "Urgent"
              }
            },
            {
              "when": {
                "op": "eq",
                "args": [
                  {
                    "col": "status"
                  },
                  {
                    "const": "Open"
                  }
                ]
              },
              "then": {
                "const": "Normal"
              }
            }
          ],
          "else": {
            "const": "Done"
          }
        }
      }
    ],
    "valueMaps": [],
    "sort": []
  },
  "output": {
    "sheetName": "Orders with priority",
    "direction": "ltr",
    "language": "en",
    "titleRows": [],
    "headerStyle": {
      "bold": true
    },
    "columns": [
      {
        "header": "Order",
        "from": "orderId"
      },
      {
        "header": "Customer",
        "from": "customer"
      },
      {
        "header": "Amount",
        "from": "amount",
        "format": "#,##0.00"
      },
      {
        "header": "Priority",
        "from": "priority"
      },
      {
        "header": "Order Date",
        "from": "orderDate",
        "format": "DD/MM/YYYY"
      }
    ]
  },
  "validations": [],
  "unsupported": [],
  "assumptions": [],
  "name": "Orders export -> orders with priority",
  "meta": {
    "source": "examplePair",
    "status": "verified"
  }
}
